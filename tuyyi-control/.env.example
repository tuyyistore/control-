# Use a long random string for SESSION_SECRET (at least 32 characters)
DASHBOARD_PIN=change-this-to-your-own-pin
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
GITHUB_TOKEN=github_pat_your_token_here
VERCEL_TOKEN=your_vercel_token_here
# Optional: default GitHub owner/org
GITHUB_OWNER=your-github-username
# Local development only; Vercel sets its own runtime port
PORT=3000
NODE_ENV=development
